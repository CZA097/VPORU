# Порт сервера
PORT=4400

# Облачная примерка. Без ключа генерация заблокирована.
# Ключи читаются только на сервере и никогда не попадают в браузер.
GENAPI_KEY=
FASHN_API_KEY=

# Цена одной генерации для интерфейса и лимитов.
GENAPI_PRICE=9.75
# Сколько платных генераций разрешено за сутки (защита от случайных трат).
GENAPI_DAILY_LIMIT=20
