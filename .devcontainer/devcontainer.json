{
  "name": "Vporu",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install && npm run build",
  "postStartCommand": "npm start",
  "forwardPorts": [4500],
  "portsAttributes": {
    "4500": {
      "label": "Vporu",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "containerEnv": {
    "HOST": "0.0.0.0",
    "PORT": "4500"
  }
}
